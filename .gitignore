# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Virtual environments ---
.venv/
venv/
env/

# --- uv ---
.uv-cache/

# --- Testing & coverage ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Environment variables / secrets ---
.env
.env.*
!.env.example

# SSH material for the EC2 deployment (docs/aws/EC2.md). The .pem downloaded
# from the AWS console and the CI deploy keypair both tend to get left in the
# working directory, where a single `git add -A` publishes them to a public
# repository. pre-commit's detect-private-key hook catches this too, but only
# for someone who has run `make install` -- this covers everyone else.
*.pem
*.key
id_rsa*
id_ed25519*
pi-deploy*
pi-cicd*
!*.pub

# --- IDE / editor ---
.vscode/
.idea/
.claude/
*.swp

# --- OS ---
.DS_Store
Thumbs.db

# --- Logs ---
*.log
logs/

# --- Docker ---
*.pid

# --- Runtime upload/processing output at the repo root ---
# The app itself writes under backend/storage (app/core/paths.py), but a
# server started from the repo root leaves a stray ./storage behind. Ignore
# it so uploaded images can never be committed by accident.
/storage/

# --- Frontend (reserved for later phases) ---
node_modules/
dist/
.next/
