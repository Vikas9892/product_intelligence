# Copy this file to .env and fill in real values for local development.
# Never commit the real .env file — it is gitignored.
#
# Config groups are nested with "__" (double underscore), e.g.
# APPLICATION__PORT sets Settings.application.port. See
# app/core/settings.py for the full validated schema and
# app/core/config.py for how it's loaded as a singleton.
#
# Every value below is the same as the built-in default — you only need to
# uncomment/change what you want to override. An empty backend/.env (or no
# file at all) is a valid, working local configuration.

# --- Application ---
APPLICATION__NAME=product-intelligence-backend
APPLICATION__ENVIRONMENT=local        # local | development | staging | production | test
APPLICATION__DEBUG=true
APPLICATION__HOST=0.0.0.0
APPLICATION__PORT=8000
APPLICATION__API_PREFIX=/api/v1
# Host headers TrustedHostMiddleware accepts. "*" (any host) is fine for
# local dev but rejected in production — Settings raises a validation
# error at startup if it's still "*" there. JSON list syntax:
APPLICATION__TRUSTED_HOSTS=["*"]
# Origins allowed to make cross-origin browser requests (CORSMiddleware).
# Empty by default (no cross-origin access). JSON list syntax, e.g.:
# APPLICATION__CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
APPLICATION__CORS_ALLOWED_ORIGINS=[]

# --- Database ---
# SQLite is fine for local dev. Production must use a real database —
# Settings raises a validation error at startup if it doesn't.
DATABASE__URL=sqlite+aiosqlite:///./storage/app.db
DATABASE__ECHO=false
DATABASE__POOL_SIZE=5

# --- AI Models ---
# openai_api_key/embedding_model/llm_model reserve the shape for a later,
# OpenAI-based text embedding/LLM phase — no calls are made yet, leave the
# key blank for now.
AI_MODELS__OPENAI_API_KEY=
AI_MODELS__EMBEDDING_MODEL=text-embedding-3-small
AI_MODELS__LLM_MODEL=gpt-4o-mini
AI_MODELS__REQUEST_TIMEOUT_SECONDS=30
# CLIP image embeddings (Phase 4) — in active use.
AI_MODELS__CLIP_MODEL_NAME=openai/clip-vit-base-patch32
# "auto" picks CUDA if available, else CPU. Override with "cpu"/"cuda" to force one.
AI_MODELS__EMBEDDING_DEVICE=auto
AI_MODELS__EMBEDDING_BATCH_SIZE=8
# Sentence Transformers text embeddings (Phase 6) — in active use.
AI_MODELS__TEXT_MODEL_NAME=BAAI/bge-small-en-v1.5
AI_MODELS__TEXT_DEVICE=auto
AI_MODELS__TEXT_BATCH_SIZE=32
AI_MODELS__TEXT_NORMALIZE=true

# --- Vector Store (Phase 5-6) ---
# Qdrant connection for semantic product search. Both collections are
# auto-created (cosine distance) on first use if they don't exist yet.
VECTOR_STORE__URL=http://localhost:6333
VECTOR_STORE__IMAGE_COLLECTION_NAME=product_images
# Must match the configured CLIP model's projection dimension.
VECTOR_STORE__IMAGE_VECTOR_SIZE=512
VECTOR_STORE__TEXT_COLLECTION_NAME=product_text
# Must match the configured text model's embedding dimension.
VECTOR_STORE__TEXT_VECTOR_SIZE=384
VECTOR_STORE__DEFAULT_TOP_K=10

# --- Hybrid Search (Phase 6) ---
# Score fusion weights: FinalScore = IMAGE_WEIGHT * ImageScore + TEXT_WEIGHT * TextScore.
HYBRID_SEARCH__IMAGE_WEIGHT=0.7
HYBRID_SEARCH__TEXT_WEIGHT=0.3

# --- Catalog Intelligence (Phase 7) ---
# Automatic per-upload enrichment: extracted attributes, generated tags, quality score.
CATALOG_INTELLIGENCE__ENABLED=true
CATALOG_INTELLIGENCE__ENABLE_TEXT_ATTRIBUTES=true
CATALOG_INTELLIGENCE__ENABLE_IMAGE_ATTRIBUTES=true
# Predictions/tags below this confidence are dropped from the final result.
CATALOG_INTELLIGENCE__ATTRIBUTE_CONFIDENCE_THRESHOLD=0.60
CATALOG_INTELLIGENCE__MAX_GENERATED_TAGS=20
# Quality score = COMPLETENESS_WEIGHT*completeness + CONFIDENCE_WEIGHT*confidence + CONSISTENCY_WEIGHT*consistency.
CATALOG_INTELLIGENCE__QUALITY_COMPLETENESS_WEIGHT=0.50
CATALOG_INTELLIGENCE__QUALITY_CONFIDENCE_WEIGHT=0.30
CATALOG_INTELLIGENCE__QUALITY_CONSISTENCY_WEIGHT=0.20

# --- Duplicate Detection (Phase 8) ---
# mode: "off" (skip entirely), "warn" (store, attach the decision), "block" (reject, 409).
DUPLICATE_DETECTION__MODE=warn
# Minimum overall_similarity for a candidate to count as a match.
DUPLICATE_DETECTION__THRESHOLD=0.90
# How many hybrid-search candidates SimilarityScorer evaluates per upload.
DUPLICATE_DETECTION__TOP_K=10
# SimilarityScorer's confidence formula: overall = sum(weight * signal_score).
# Must sum to 1.0.
DUPLICATE_DETECTION__IMAGE_WEIGHT=0.35
DUPLICATE_DETECTION__TEXT_WEIGHT=0.25
DUPLICATE_DETECTION__METADATA_WEIGHT=0.20
DUPLICATE_DETECTION__ATTRIBUTE_WEIGHT=0.20

# --- Storage ---
STORAGE__UPLOAD_DIR=./storage/uploads
STORAGE__MAX_UPLOAD_SIZE_MB=10
# JSON list syntax:
STORAGE__ALLOWED_IMAGE_EXTENSIONS=[".jpg", ".jpeg", ".png", ".webp"]
STORAGE__PROCESSED_DIR=./storage/processed
# Safety ceiling: reject images larger than this in either dimension
# before any resizing work (decompression-bomb protection).
STORAGE__MAX_IMAGE_DIMENSION_PX=8000
# Target size (px, longest side) images are resized to, preserving
# aspect ratio — the standardized dimension AI models will consume.
STORAGE__PROCESSED_IMAGE_SIZE_PX=1024

# --- Security ---
# REQUIRED in production: startup fails if this is still the default value.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECURITY__SECRET_KEY=insecure-dev-secret-key-change-me-1234567890
SECURITY__ALGORITHM=HS256
SECURITY__ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Logging ---
LOGGING__LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOGGING__JSON_LOGS=false
