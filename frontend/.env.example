# Frontend environment configuration.
# Copy to `.env.local` for local development and override as needed.
# Only NEXT_PUBLIC_* variables are exposed to the browser. Every value has a
# safe default in src/config/env.ts, so an empty file is a valid configuration.

# Backend origin the Next.js rewrite proxy forwards to (server-side only, never
# sent to the browser). The browser always calls this app's own origin; see the
# "API proxy" section in README.md for why (backend CORS is disabled by default
# and does not expose its timing header cross-origin).
BACKEND_ORIGIN=http://localhost:8000

# Base URL the BROWSER sends API requests to, without the API prefix.
# Leave EMPTY (the default) to use the same-origin proxy above — recommended.
# Set to an absolute URL (e.g. http://localhost:8000) to bypass the proxy and
# call the backend directly; that requires the backend to run with
# APPLICATION__CORS_ALLOWED_ORIGINS configured.
NEXT_PUBLIC_API_BASE_URL=

# Versioned API prefix the backend mounts business routes under.
NEXT_PUBLIC_API_PREFIX=/api/v1

# Header name for API-key auth (only used when the backend enterprise layer is on).
NEXT_PUBLIC_API_KEY_HEADER=X-API-Key

# Set to "true" only when the backend runs with ENTERPRISE__ENABLED=true.
# Default (unset/false) is single-tenant demo mode: no auth gate, no API key.
NEXT_PUBLIC_ENTERPRISE_ENABLED=false

# Display name used in the UI shell and document title.
NEXT_PUBLIC_APP_NAME=Product Intelligence
